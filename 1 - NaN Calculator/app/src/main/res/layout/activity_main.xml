<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <Button
        android:id="@+id/resetAllButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset All"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/infoButton"
        android:layout_width="113dp"
        android:layout_height="53dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#2196F3"
        android:text="Help"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/supportView"
        android:layout_width="40dp"
        android:layout_height="200dp"
        android:src="@drawable/support"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/trayScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.6"/>

    <ImageView
        android:id="@+id/rodView"
        android:layout_width="320dp"
        android:layout_height="24dp"
        android:src="@drawable/rod"
        android:scaleType="fitXY"
        android:transformPivotX="160dp"
        android:transformPivotY="12dp"
        app:layout_constraintTop_toTopOf="@id/supportView"
        app:layout_constraintBottom_toTopOf="@id/supportView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftPanAssembly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rodView"
        app:layout_constraintStart_toStartOf="@id/rodView"
        android:layout_marginStart="-30dp"> <ImageView
        android:id="@+id/leftChains"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:src="@drawable/chains"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/leftPanImage"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:src="@drawable/pan"
            android:scaleType="fitXY"
            app:layout_constraintTop_toBottomOf="@id/leftChains"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <GridLayout
            android:id="@+id/leftPan"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:columnCount="3"
            android:gravity="bottom|center_horizontal"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="@id/leftPanImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightPanAssembly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rodView"
        app:layout_constraintEnd_toEndOf="@id/rodView"
        android:layout_marginEnd="-30dp"> <ImageView
        android:id="@+id/rightChains"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:src="@drawable/chains"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/rightPanImage"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:src="@drawable/pan"
            android:scaleType="fitXY"
            app:layout_constraintTop_toBottomOf="@id/rightChains"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <GridLayout
            android:id="@+id/rightPan"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:columnCount="3"
            android:gravity="bottom|center_horizontal"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="@id/rightPanImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/trayScrollView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#EEEEEE"
        app:layout_constraintBottom_toBottomOf="parent">

        <GridLayout
            android:id="@+id/weightTrayGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:padding="16dp"
            android:useDefaultMargins="true">

            <ImageView
                android:id="@+id/itemStrawberry"
                android:tag="20"
                android:src="@drawable/berry"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:padding="4dp"/>

            <ImageView
                android:id="@+id/itemLemon"
                android:tag="70"
                android:src="@drawable/lemon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:padding="4dp"/>

            <ImageView
                android:id="@+id/itemApple"
                android:tag="100"
                android:src="@drawable/apple"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:padding="4dp"/>

            <ImageView
                android:id="@+id/itemBanana"
                android:tag="120"
                android:src="@drawable/banana"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:padding="4dp"/>
            <TextView android:id="@+id/weight1" android:tag="1" android:text="1g" android:layout_width="70dp" android:layout_height="70dp" android:background="#CFD8DC" android:gravity="center" android:textStyle="bold"/>
            <TextView android:id="@+id/weight10" android:tag="10" android:text="10g" android:layout_width="70dp" android:layout_height="70dp" android:background="#B0BEC5" android:gravity="center" android:textStyle="bold"/>
            <TextView android:id="@+id/weight100" android:tag="100" android:text="100g" android:layout_width="70dp" android:layout_height="70dp" android:background="#90A4AE" android:gravity="center" android:textStyle="bold"/>
            <TextView android:id="@+id/weight1000" android:tag="1000" android:text="1000g" android:layout_width="70dp" android:layout_height="70dp" android:background="#607D8B" android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold"/>

        </GridLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>